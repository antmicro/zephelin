typealias floating_point {
    exp_dig = 8;
    mant_dig = 24;
    byte_order = le;
    align = 8;
} := float32;

stream {
	id = 1;
	event.header := struct event_header;
	packet.context := struct {
		uint16_t packet_size;
	};
};

event {
	stream_id = 1;
	name = zpl_tflm_enter;
	id = 0x100;
	fields := struct {
		uint8_t cpu_id;
		uint32_t thread_id;
		uint16_t subgraph_idx;
		uint16_t op_idx;
		uint16_t tag_len;
		ctf_bounded_string_t tag[tag_len];
		uint32_t arena_used_bytes;
		uint32_t arena_tail_usage;
	};
};

event {
	stream_id = 1;
	name = zpl_tflm_exit;
	id = 0x101;
	fields := struct {
		uint8_t cpu_id;
		uint32_t thread_id;
		uint16_t subgraph_idx;
		uint16_t op_idx;
		uint16_t tag_len;
		ctf_bounded_string_t tag[tag_len];
		uint32_t arena_used_bytes;
		uint32_t arena_tail_usage;
	};
};

enum zpl_memory_region : uint8_t {
	ZPL_STACK,
	ZPL_HEAP,
	ZPL_K_HEAP,
	ZPL_MEM_SLAB,
};

event {
	stream_id = 1;
	name = zpl_tvm_enter;
	id = 0x102;
	fields := struct {
		uint8_t cpu_id;
		uint32_t thread_id;
		uint8_t op_idx;
		uint16_t tag_len;
		ctf_bounded_string_t tag[tag_len];
	};
};

event {
	stream_id = 1;
	name = zpl_tvm_exit;
	id = 0x103;
	fields := struct {
		uint8_t cpu_id;
		uint32_t thread_id;
		uint8_t op_idx;
		uint16_t tag_len;
		ctf_bounded_string_t tag[tag_len];
	};
};

event {
	stream_id = 0;
	name = zpl_inference_enter;
	id = 0x104;
	fields := struct {
		uint8_t cpu_id;
		uint32_t thread_id;
		uint32_t model_id;
	};
};

event {
	stream_id = 0;
	name = zpl_inference_exit;
	id = 0x105;
	fields := struct {
		uint8_t cpu_id;
		uint32_t thread_id;
		uint32_t model_id;
	};
};

event {
	stream_id = 0;
	name = zpl_memory;
	id = 0x106;
	fields := struct {
		enum zpl_memory_region memory_region;
		uint32_t memory_addr;
		uint32_t used;
		uint32_t unused;
		uint32_t for_thread_id;
	};
};

event {
	stream_id = 0;
	name = zpl_cpu_load_event;
	id = 0x107;
	fields := struct {
		uint8_t cpu_id;
		uint16_t cpu_load;
	};
};

event {
	stream_id = 0;
	name = zpl_die_temp_event;
	id = 0x108;
	fields := struct {
		uint16_t sensor_count;
		float32 die_temp[sensor_count];
	};
};

event {
	stream_id = 0;
	name = zpl_scope_enter;
	id = 0x109;
	fields := struct {
		uint8_t cpu_id;
		uint32_t thread_id;
		uint16_t scope_name_len;
		ctf_bounded_string_t scope_name[scope_name_len];
		uint64_t cycles;
	};
};

event {
	stream_id = 0;
	name = zpl_scope_exit;
	id = 0x10A;
	fields := struct {
		uint8_t cpu_id;
		uint32_t thread_id;
		uint16_t scope_name_len;
		ctf_bounded_string_t scope_name[scope_name_len];
		uint64_t cycles;
	};
};
