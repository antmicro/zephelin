config ZPL_TVM_EVENTS
	bool "Enables micro TVM events"
	depends on ZPL

config ZPL_TVM_PROFILER
	bool "Enables micro TVM profiler"
	depends on ZPL
	select ZPL_TVM_EVENTS

config ZPL_TVM_PROFILER_MAX_EVENTS
	int "Max number of buffered event"
	default 32
	depends on ZPL_TVM_PROFILER

config ZPL_TVM_PROFILER_DELAYED_EMISSION
	bool "Buffer and delay TVM profiling events"
	depends on ZPL_TVM_PROFILER
	help
	  Instead of emitting a trace event on every TVM operator boundary,
	  store the timestamps in memory and emit all the events at once when
	  the inference is done. This keeps the tracing overhead out of the
	  measured inference.
