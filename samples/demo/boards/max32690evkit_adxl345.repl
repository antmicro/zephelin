sysbus:
    init:
        Tag <0x60000000 0x800000> "sdram1"
        Tag <0x40008000 0x3220> "gpio0 / pinctrl / gpio1 / gpio2"
        Tag <0x40010000 0x1000> "timer0"
        Tag <0x40011000 0x1000> "timer1"
        Tag <0x40012000 0x1000> "timer2"
        Tag <0x40013000 0x1000> "timer3"
        Tag <0x4001e000 0x1000> "i2c1"
        Tag <0x4001f000 0x1000> "i2c2"
        Tag <0x40028000 0x1000> "dma0"
        Tag <0x40034000 0x1000> "adc"
        Tag <0x40039000 0x1000> "hpb"
        Tag <0x4003d000 0x1000> "w1"
        Tag <0x40043000 0x1000> "uart1"
        Tag <0x40046000 0x1000> "spi0"
        Tag <0x40047000 0x1000> "spi1"
        Tag <0x40048000 0x1000> "spi2"
        Tag <0x4004d000 0x1000> "trng"
        Tag <0x40064000 0x1000> "can0"
        Tag <0x40065000 0x1000> "can1"
        Tag <0x400b1000 0x1000> "usbhs"
        Tag <0x40003000 0x400> "wdt0"
        Tag <0x40006000 0x400> "rtc_counter"
        Tag <0x40029000 0x400> "flc0"
        Tag <0x40029400 0x400> "flc1"
        Tag <0x40080800 0x400> "wdt1"
        Tag <0x40080c00 0x400> "lptimer0"
        Tag <0x40081000 0x400> "lptimer1"
        Tag <0x40081400 0x400> "uart3"
        Tag <0x400be000 0x400> "spi3"
        Tag <0x400be400 0x400> "spi4"
        Tag <0x40080400 0x200> "gpio3"
        Tag <0x4000c000 0x20> "gpio4"
        Tag <0xe000e010 0x10> "systick"

flash0_flash1: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x300000

sram0: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x20000

sram1: Memory.MappedMemory @ sysbus 0x20020000
    size: 0x20000

sram2: Memory.MappedMemory @ sysbus 0x20040000
    size: 0x20000

sram3: Memory.MappedMemory @ sysbus 0x20060000
    size: 0x20000

sram4: Memory.MappedMemory @ sysbus 0x20080000
    size: 0x20000

sram5: Memory.MappedMemory @ sysbus 0x200a0000
    size: 0x20000

sram6: Memory.MappedMemory @ sysbus 0x200c0000
    size: 0x10000

sram7: Memory.MappedMemory @ sysbus 0x200d0000
    size: 0x10000

// autogenerated

gcr: Python.PythonPeripheral @ sysbus 0x40000000
    size: 0x400
    initable: false
    script: "request.Value = 0xFFFFFFFF if request.Offset == 0x8 else 0x0"

uart0: UART.MAX32655_UART @ sysbus 0x40042000
    ->nvic0@14

uart2: UART.MAX32655_UART @ sysbus 0x40044000
    ->nvic0@34

nvic0: IRQControllers.NVIC @ {
    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: cpu0 }
}
    -> cpu0@0

cpu0: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    nvic: nvic0

// adi,max32690evkit overlay

sysbus:
    init add:
        Tag <0x4002A100 0x4> "ICC_ctrl" 0xffffffff

// cortex-m overlay

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 72000000

i2c0: I2C.MAX32650_I2C @ sysbus 0x4001D000
    -> nvic0@13

adxl345: Sensors.ADXL345@ i2c0 0x53
