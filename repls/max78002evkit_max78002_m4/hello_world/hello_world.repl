sysbus:
    init:
        Tag <0x10000000 0x100000> "m4_partition"
        Tag <0x10140000 0x100000> "rv32_partition"
        Tag <0x10100000 0x40000> "m4_storage_partition"
        Tag <0x10240000 0x40000> "rv32_storage_partition"
        Tag <0x40008000 0x2200> "gpio0 / pinctrl / gpio1"
        Tag <0x40046000 0x2000> "spi1"
        Tag <0x40010000 0x1000> "timer0"
        Tag <0x40011000 0x1000> "timer1"
        Tag <0x40012000 0x1000> "timer2"
        Tag <0x40013000 0x1000> "timer3"
        Tag <0x4001d000 0x1000> "i2c0"
        Tag <0x4001e000 0x1000> "i2c1"
        Tag <0x4001f000 0x1000> "i2c2"
        Tag <0x40028000 0x1000> "dma0"
        Tag <0x40034000 0x1000> "adc"
        Tag <0x4003d000 0x1000> "w1"
        Tag <0x4003e000 0x1000> "mbox"
        Tag <0x40043000 0x1000> "uart1"
        Tag <0x40044000 0x1000> "uart2"
        Tag <0x4004d000 0x1000> "trng"
        Tag <0x400be000 0x1000> "spi0"
        Tag <0x40003000 0x400> "wdt0"
        Tag <0x40006000 0x400> "rtc_counter"
        Tag <0x40006400 0x400> "wut0"
        Tag <0x40029000 0x400> "flc0"
        Tag <0x40080800 0x400> "wdt1"
        Tag <0x40080c00 0x400> "lptimer0"
        Tag <0x40081000 0x400> "lptimer1"
        Tag <0x40081400 0x400> "uart3"
        Tag <0x40080400 0x200> "gpio2"
        Tag <0x40080600 0x200> "gpio3"
        Tag <0xe000e010 0x10> "systick"

flash0: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x280000

sram1: Memory.MappedMemory @ sysbus 0x20008000
    size: 0x8000

sram2: Memory.MappedMemory @ sysbus 0x20010000
    size: 0x10000

sram3: Memory.MappedMemory @ sysbus 0x20020000
    size: 0x10000

sram4_sram5_sram6: Memory.MappedMemory @ sysbus 0x20030000
    size: 0x2c000

sram7: Memory.MappedMemory @ sysbus 0x2005c000
    size: 0x4000

// autogenerated

gcr: Python.PythonPeripheral @ sysbus 0x40000000
    size: 0x400
    initable: false
    script: "request.Value = 0xFFFFFFFF if request.Offset == 0x8 else 0x0"

uart0: UART.MAX32655_UART @ sysbus 0x40042000
    ->nvic0@14

nvic0: IRQControllers.NVIC @ {
    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: cpu0 }
}
    -> cpu0@0
    systickFrequency: 120000000

cpu0: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    nvic: nvic0

// cortex-m overlay

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 72000000
