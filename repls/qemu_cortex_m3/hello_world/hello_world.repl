sysbus:
    init:
        Tag <0x40004000 0x1000> "gpio0"
        Tag <0x40005000 0x1000> "gpio1"
        Tag <0x40006000 0x1000> "gpio2"
        Tag <0x40007000 0x1000> "gpio3"
        Tag <0x40024000 0x1000> "gpio4"
        Tag <0x40025000 0x1000> "gpio5"
        Tag <0x40026000 0x1000> "gpio6"
        Tag <0x400fd000 0x1000> "flash-controller@400fd000"
        Tag <0x40048000 0x3c> "eth"
        Tag <0xe000e010 0x10> "systick"

flash0: Memory.MappedMemory @ sysbus 0x0
    size: 0x40000

sram0: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x10000

// autogenerated

nvic0: IRQControllers.NVIC @ {
    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: cpu0 }
}
    -> cpu0@0
    systickFrequency: 12000000

cpu0: CPU.CortexM @ sysbus
    cpuType: "cortex-m3"
    nvic: nvic0

uart0: UART.PL011 @ sysbus 0x4000c000
    ->nvic0@5

uart1: UART.PL011 @ sysbus 0x4000d000
    ->nvic0@6

uart2: UART.PL011 @ sysbus 0x4000e000
    ->nvic0@33

// cortex-m overlay

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 72000000
