From 8a9c8882c6125ad0db51b3d49e2cbe4f3551746e Mon Sep 17 00:00:00 2001
From: Jedrzej Czykier <jczykier@antmicro.com>
Date: Tue, 3 Mar 2026 16:31:53 +0100
Subject: [PATCH 22/39] boards: Add timer for stm32f429i_disc1

Signed-off-by: Jedrzej Czykier <jczykier@antmicro.com>
---
 .../st/stm32f429i_disc1/support/stm32f4_discovery.repl | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/boards/st/stm32f429i_disc1/support/stm32f4_discovery.repl b/boards/st/stm32f429i_disc1/support/stm32f4_discovery.repl
index 78e2cf1b5be..83959055025 100644
--- a/boards/st/stm32f429i_disc1/support/stm32f4_discovery.repl
+++ b/boards/st/stm32f429i_disc1/support/stm32f4_discovery.repl
@@ -49,6 +49,16 @@ sysbus:
         Tag <0x40012200 0x50> "adc3"
         Tag <0xe000e010 0x10> "systick"
 
+pwr: Python.PythonPeripheral @ sysbus 0x40007000
+    size: 0x400
+    initable: true
+    filename: "scripts/pydev/flipflop.py"
+
+timers2: Timers.STM32_Timer @ sysbus 0x40000000
+    frequency: 10000000
+    initialLimit: 0xffffffff
+    ->nvic0@28
+
 usart1: UART.STM32_UART @ sysbus <0x40011000, +0x400>
     ->nvic0@37
 
-- 
2.47.3

