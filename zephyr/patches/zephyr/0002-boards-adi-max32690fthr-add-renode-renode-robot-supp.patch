From ab1add56b3539f8a5f63b2e706106689d15af842 Mon Sep 17 00:00:00 2001
From: Maciej Sobkowski <msobkowski@antmicro.com>
Date: Fri, 1 Aug 2025 13:06:32 +0200
Subject: [PATCH 02/38] boards: adi: max32690fthr: add renode/renode-robot
 support

Signed-off-by: Maciej Sobkowski <msobkowski@antmicro.com>
Signed-off-by: Krzysztof Sychla <ksychla@antmicro.com>
---
 boards/adi/max32690fthr/board.cmake           |   9 ++
 .../max32690fthr_max32690_m4.yaml             |   7 ++
 .../adi/max32690fthr/support/hello_world.repl | 106 ++++++++++++++++++
 boards/adi/max32690fthr/support/max32690.resc |  19 ++++
 4 files changed, 141 insertions(+)
 create mode 100644 boards/adi/max32690fthr/support/hello_world.repl
 create mode 100644 boards/adi/max32690fthr/support/max32690.resc

diff --git a/boards/adi/max32690fthr/board.cmake b/boards/adi/max32690fthr/board.cmake
index 43b3efb7b59..edd5214d31f 100644
--- a/boards/adi/max32690fthr/board.cmake
+++ b/boards/adi/max32690fthr/board.cmake
@@ -1,6 +1,15 @@
 # Copyright (c) 2023-2024 Analog Devices, Inc.
 # SPDX-License-Identifier: Apache-2.0
 
+set(SUPPORTED_EMU_PLATFORMS renode)
+set(RENODE_SCRIPT ${CMAKE_CURRENT_LIST_DIR}/support/max32690.resc)
+set(RENODE_UART sysbus.uart0)
+
+set_ifndef(BOARD_SIM_RUNNER renode)
+set_ifndef(BOARD_ROBOT_RUNNER renode-robot)
+include(${ZEPHYR_BASE}/boards/common/renode.board.cmake)
+include(${ZEPHYR_BASE}/boards/common/renode_robot.board.cmake)
+
 board_runner_args(jlink "--device=MAX32690" "--reset-after-load")
 
 include(${ZEPHYR_BASE}/boards/common/openocd-adi-max32.boards.cmake)
diff --git a/boards/adi/max32690fthr/max32690fthr_max32690_m4.yaml b/boards/adi/max32690fthr/max32690fthr_max32690_m4.yaml
index d779aa2140b..2fc03352b59 100644
--- a/boards/adi/max32690fthr/max32690fthr_max32690_m4.yaml
+++ b/boards/adi/max32690fthr/max32690fthr_max32690_m4.yaml
@@ -18,3 +18,10 @@ supported:
   - usbd
 ram: 128
 flash: 3072
+simulation:
+  - name: renode
+    exec: renode
+testing:
+  renode:
+    uart: sysbus.uart0
+    resc: boards/adi/max32690fthr/support/max32690.resc
diff --git a/boards/adi/max32690fthr/support/hello_world.repl b/boards/adi/max32690fthr/support/hello_world.repl
new file mode 100644
index 00000000000..1cc5cd25752
--- /dev/null
+++ b/boards/adi/max32690fthr/support/hello_world.repl
@@ -0,0 +1,106 @@
+sysbus:
+    init:
+        Tag <0x40008000 0x3220> "gpio0 / pinctrl / gpio1 / gpio2"
+        Tag <0x40010000 0x1000> "timer0"
+        Tag <0x40011000 0x1000> "timer1"
+        Tag <0x40012000 0x1000> "timer2"
+        Tag <0x40013000 0x1000> "timer3"
+        Tag <0x4001d000 0x1000> "i2c0"
+        Tag <0x4001e000 0x1000> "i2c1"
+        Tag <0x4001f000 0x1000> "i2c2"
+        Tag <0x40027000 0x1000> "spixf"
+        Tag <0x40028000 0x1000> "dma0"
+        Tag <0x40034000 0x1000> "adc"
+        Tag <0x40039000 0x1000> "hpb"
+        Tag <0x4003d000 0x1000> "w1"
+        Tag <0x4003e000 0x1000> "mbox"
+        Tag <0x40043000 0x1000> "uart1"
+        Tag <0x40046000 0x1000> "spi0"
+        Tag <0x40047000 0x1000> "spi1"
+        Tag <0x40048000 0x1000> "spi2"
+        Tag <0x4004d000 0x1000> "trng"
+        Tag <0x40064000 0x1000> "can0"
+        Tag <0x40065000 0x1000> "can1"
+        Tag <0x400b1000 0x1000> "usbhs"
+        Tag <0x40003000 0x400> "wdt0"
+        Tag <0x40006000 0x400> "rtc_counter"
+        Tag <0x40029000 0x400> "flc0"
+        Tag <0x40029400 0x400> "flc1"
+        Tag <0x40080800 0x400> "wdt1"
+        Tag <0x40080c00 0x400> "lptimer0"
+        Tag <0x40081000 0x400> "lptimer1"
+        Tag <0x40081400 0x400> "uart3"
+        Tag <0x400be000 0x400> "spi3"
+        Tag <0x400be400 0x400> "spi4"
+        Tag <0x40006400 0x200> "wut0"
+        Tag <0x40006600 0x200> "wut1"
+        Tag <0x40080400 0x200> "gpio3"
+        Tag <0x4000c000 0x20> "gpio4"
+        Tag <0xe000e010 0x10> "systick"
+
+flash0: Memory.MappedMemory @ sysbus 0x10000000
+    size: 0x300000
+
+flash1: Memory.MappedMemory @ sysbus 0x10300000
+    size: 0x40000
+
+sram0: Memory.MappedMemory @ sysbus 0x20000000
+    size: 0x20000
+
+sram1: Memory.MappedMemory @ sysbus 0x20020000
+    size: 0x20000
+
+sram2: Memory.MappedMemory @ sysbus 0x20040000
+    size: 0x20000
+
+sram3: Memory.MappedMemory @ sysbus 0x20060000
+    size: 0x20000
+
+sram4: Memory.MappedMemory @ sysbus 0x20080000
+    size: 0x20000
+
+sram5: Memory.MappedMemory @ sysbus 0x200a0000
+    size: 0x20000
+
+sram6: Memory.MappedMemory @ sysbus 0x200c0000
+    size: 0x10000
+
+sram7: Memory.MappedMemory @ sysbus 0x200d0000
+    size: 0x10000
+
+sram8: Memory.MappedMemory @ sysbus 0x20100000
+    size: 0x20000
+
+// autogenerated
+
+gcr: Python.PythonPeripheral @ sysbus 0x40000000
+    size: 0x400
+    initable: false
+    script: "request.Value = 0xFFFFFFFF if request.Offset == 0x8 else 0x0"
+
+uart0: UART.MAX32655_UART @ sysbus 0x40042000
+    ->nvic0@14
+
+uart2: UART.MAX32655_UART @ sysbus 0x40044000
+    ->nvic0@34
+
+nvic0: IRQControllers.NVIC @ {
+    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: cpu0 }
+}
+    -> cpu0@0
+    systickFrequency: 120000000
+
+cpu0: CPU.CortexM @ sysbus
+    cpuType: "cortex-m4f"
+    nvic: nvic0
+
+// adi,max32690fthr overlay
+
+sysbus:
+    init add:
+        Tag <0x4002A100 0x4> "ICC_ctrl" 0xffffffff
+
+// cortex-m overlay
+
+dwt: Miscellaneous.DWT @ sysbus 0xE0001000
+    frequency: 72000000
diff --git a/boards/adi/max32690fthr/support/max32690.resc b/boards/adi/max32690fthr/support/max32690.resc
new file mode 100644
index 00000000000..2be7b411a3f
--- /dev/null
+++ b/boards/adi/max32690fthr/support/max32690.resc
@@ -0,0 +1,19 @@
+$name?="max32690"
+
+using sysbus
+mach create $name
+machine LoadPlatformDescription $ORIGIN/hello_world.repl
+machine LoadPlatformDescriptionFromString
+"""
+cpu0:
+    PerformanceInMips: 30
+"""
+
+showAnalyzer uart0
+
+macro reset
+"""
+    sysbus LoadELF $elf
+    cpu0 VectorTableOffset `sysbus GetSymbolAddress "_vector_table"`
+"""
+runMacro $reset
-- 
2.47.1

