 subsys/tracing/ctf/ctf_top.h     |   5 +-
 subsys/tracing/ctf/tsdl/metadata | 131 +++++++++++++++++++++++++++++--
 2 files changed, 128 insertions(+), 8 deletions(-)

diff --git a/subsys/tracing/ctf/ctf_top.h b/subsys/tracing/ctf/ctf_top.h
index 783f69eb9e0..c5c60bf532b 100644
--- a/subsys/tracing/ctf/ctf_top.h
+++ b/subsys/tracing/ctf/ctf_top.h
@@ -68,13 +68,14 @@ static inline uint64_t soft_cycle_get_64() {
 	}
 
 #ifdef CONFIG_TRACING_CTF_TIMESTAMP
-#define CTF_EVENT(...)                                                         \
+#define CTF_EVENT(event_id, ...)                                               \
 	{                                                                      \
 		int key = irq_lock();                                          \
 		const uint16_t stream_id = 0;                                  \
 		const uint16_t packet_size = 0;                                \
 		const uint64_t tstamp = k_cyc_to_ns_floor64(soft_cycle_get_64()); \
-		CTF_GATHER_FIELDS(stream_id, packet_size, tstamp, __VA_ARGS__) \
+		const uint8_t cpu_id = arch_curr_cpu()->id;                    \
+		CTF_GATHER_FIELDS(stream_id, packet_size, tstamp, event_id, cpu_id, ##__VA_ARGS__) \
 		irq_unlock(key);                                               \
 	}
 #else
