diff --git a/boards/microchip/mpfs_icicle/support/mpfs_icicle_polarfire_e51.resc b/boards/microchip/mpfs_icicle/support/mpfs_icicle_polarfire_e51.resc
new file mode 100644
index 00000000000..9d5e6dc0263
--- /dev/null
+++ b/boards/microchip/mpfs_icicle/support/mpfs_icicle_polarfire_e51.resc
@@ -0,0 +1,23 @@
+:name: MPFS-ICICLE-KIT
+:description: This script is prepared to run Zephyr on E51 core of PolarFire SoC Icicle Kit RISC-V board.
+
+$name?="MPFS-ICICLE-KIT"
+
+using sysbus
+mach create $name
+machine LoadPlatformDescription @platforms/boards/mpfs-icicle-kit.repl
+
+showAnalyzer mmuart0
+e51 PerformanceInMips 80
+
+# Disable U54 cores
+u54_1 IsHalted true
+u54_2 IsHalted true
+u54_3 IsHalted true
+u54_4 IsHalted true
+
+macro reset
+"""
+    sysbus LoadELF $elf
+"""
+runMacro $reset
diff --git a/boards/microchip/mpfs_icicle/support/mpfs_icicle_polarfire_u54.resc b/boards/microchip/mpfs_icicle/support/mpfs_icicle_polarfire_u54.resc
new file mode 100644
index 00000000000..7040466131b
--- /dev/null
+++ b/boards/microchip/mpfs_icicle/support/mpfs_icicle_polarfire_u54.resc
@@ -0,0 +1,23 @@
+:name: MPFS-ICICLE-KIT
+:description: This script is prepared to run Zephyr on a single U54 core of PolarFire SoC Icicle Kit RISC-V board.
+
+$name?="MPFS-ICICLE-KIT"
+
+using sysbus
+mach create $name
+machine LoadPlatformDescription @platforms/boards/mpfs-icicle-kit.repl
+
+showAnalyzer mmuart1
+
+# Disable E51 core
+e51 IsHalted true
+# Disable U54 harts other than u54_1 (specified with RV_BOOT_HART=1)
+u54_2 IsHalted true
+u54_3 IsHalted true
+u54_4 IsHalted true
+
+macro reset
+"""
+    sysbus LoadELF $elf
+"""
+runMacro $reset
