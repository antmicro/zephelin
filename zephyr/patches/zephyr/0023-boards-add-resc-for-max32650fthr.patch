From 0ee903ce7e221ae1b0068de902a21dc01f3a6b2d Mon Sep 17 00:00:00 2001
From: Jedrzej Czykier <jczykier@antmicro.com>
Date: Tue, 3 Mar 2026 16:32:20 +0100
Subject: [PATCH 23/39] boards: add resc for max32650fthr

Signed-off-by: Jedrzej Czykier <jczykier@antmicro.com>
---
 boards/adi/max32650fthr/board.cmake           |  9 +++
 boards/adi/max32650fthr/max32650fthr.yaml     |  7 ++
 .../adi/max32650fthr/support/hello_world.repl | 80 +++++++++++++++++++
 boards/adi/max32650fthr/support/max32650.resc | 24 ++++++
 4 files changed, 120 insertions(+)
 create mode 100644 boards/adi/max32650fthr/support/hello_world.repl
 create mode 100644 boards/adi/max32650fthr/support/max32650.resc

diff --git a/boards/adi/max32650fthr/board.cmake b/boards/adi/max32650fthr/board.cmake
index 716d8121461..90063601f2b 100644
--- a/boards/adi/max32650fthr/board.cmake
+++ b/boards/adi/max32650fthr/board.cmake
@@ -1,6 +1,15 @@
 # Copyright (c) 2025 Analog Devices, Inc.
 # SPDX-License-Identifier: Apache-2.0
 
+set(SUPPORTED_EMU_PLATFORMS renode)
+set(RENODE_SCRIPT ${CMAKE_CURRENT_LIST_DIR}/support/max32650.resc)
+set(RENODE_UART sysbus.uart0)
+
+set_ifndef(BOARD_SIM_RUNNER renode)
+set_ifndef(BOARD_ROBOT_RUNNER renode-robot)
+include(${ZEPHYR_BASE}/boards/common/renode.board.cmake)
+include(${ZEPHYR_BASE}/boards/common/renode_robot.board.cmake)
+
 board_runner_args(jlink "--device=MAX32650" "--reset-after-load")
 
 include(${ZEPHYR_BASE}/boards/common/openocd-adi-max32.boards.cmake)
diff --git a/boards/adi/max32650fthr/max32650fthr.yaml b/boards/adi/max32650fthr/max32650fthr.yaml
index 35d07148676..119e2e2edc4 100644
--- a/boards/adi/max32650fthr/max32650fthr.yaml
+++ b/boards/adi/max32650fthr/max32650fthr.yaml
@@ -17,3 +17,10 @@ supported:
   - rtc_counter
 ram: 256
 flash: 3072
+simulation:
+  - name: renode
+    exec: renode
+testing:
+  renode:
+    uart: sysbus.uart0
+    resc: boards/adi/max32650fthr/support/max32650.resc
diff --git a/boards/adi/max32650fthr/support/hello_world.repl b/boards/adi/max32650fthr/support/hello_world.repl
new file mode 100644
index 00000000000..5bf822a3870
--- /dev/null
+++ b/boards/adi/max32650fthr/support/hello_world.repl
@@ -0,0 +1,80 @@
+sysbus:
+    init:
+        Tag <0x40008000 0x4000> "gpio0 / pinctrl / gpio1 / gpio2 / gpio3"
+        Tag <0x40010000 0x1000> "timer0"
+        Tag <0x40011000 0x1000> "timer1"
+        Tag <0x40012000 0x1000> "timer2"
+        Tag <0x40013000 0x1000> "timer3"
+        Tag <0x40014000 0x1000> "timer4"
+        Tag <0x40015000 0x1000> "timer5"
+        Tag <0x4001d000 0x1000> "i2c0"
+        Tag <0x4001e000 0x1000> "i2c1"
+        Tag <0x40028000 0x1000> "dma0"
+        Tag <0x40034000 0x1000> "adc"
+        Tag <0x4003e000 0x1000> "mbox"
+        Tag <0x40043000 0x1000> "uart1"
+        Tag <0x40044000 0x1000> "uart2"
+        Tag <0x40046000 0x1000> "spi0"
+        Tag <0x40047000 0x1000> "spi1"
+        Tag <0x40048000 0x1000> "spi2"
+        Tag <0x400b5000 0x1000> "trng"
+        Tag <0x40003000 0x400> "wdt0"
+        Tag <0x40003400 0x400> "wdt1"
+        Tag <0x40006000 0x400> "rtc_counter"
+        Tag <0x40029000 0x400> "flc0"
+        Tag <0x400be000 0x400> "spi3"
+        Tag <0xe000e010 0x10> "systick"
+
+flash0: Memory.MappedMemory @ sysbus 0x10000000
+    size: 0x300000
+
+sram0: Memory.MappedMemory @ sysbus 0x20000000
+    size: 0x8000
+
+sram1: Memory.MappedMemory @ sysbus 0x20008000
+    size: 0x10000
+
+sram2: Memory.MappedMemory @ sysbus 0x20018000
+    size: 0x8000
+
+sram3: Memory.MappedMemory @ sysbus 0x20020000
+    size: 0x20000
+
+sram4: Memory.MappedMemory @ sysbus 0x20040000
+    size: 0x40000
+
+sram5: Memory.MappedMemory @ sysbus 0x20080000
+    size: 0x40000
+
+sram6: Memory.MappedMemory @ sysbus 0x200c0000
+    size: 0x40000
+
+// autogenerated
+
+cpu0: CPU.CortexM @ sysbus
+    cpuType: "cortex-m4f"
+    nvic: nvic0
+
+nvic0: IRQControllers.NVIC @ {
+    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: cpu0 }
+}
+    -> cpu0@0
+    systickFrequency: 120000000
+
+gcr: Miscellaneous.MAX32650_GCR @ sysbus 0x40000000
+    nvic: nvic0
+
+uart0: UART.MAX32650_UART @ sysbus 0x40042000
+    gcr: gcr
+    ->nvic0@14
+
+// adi,max32650fthr overlay
+
+sysbus:
+    init add:
+        Tag <0x4002A100 0x4> "ICC_CACHE_CTRL" 0xFFFFFFFF
+
+// cortex-m overlay
+
+dwt: Miscellaneous.DWT @ sysbus 0xE0001000
+    frequency: 72000000
diff --git a/boards/adi/max32650fthr/support/max32650.resc b/boards/adi/max32650fthr/support/max32650.resc
new file mode 100644
index 00000000000..59a4c491377
--- /dev/null
+++ b/boards/adi/max32650fthr/support/max32650.resc
@@ -0,0 +1,24 @@
+$name?="max32650"
+
+using sysbus
+mach create $name
+machine LoadPlatformDescription $ORIGIN/hello_word.repl
+machine LoadPlatformDescriptionFromString
+"""
+cpu0:
+    PerformanceInMips: 30
+
+// Sensor Clock
+timer0: Timers.MAX32650_Timer @ sysbus 0x40010000
+    gcr: gcr
+    -> nvic0@5
+"""
+
+showAnalyzer uart0
+
+macro reset
+"""
+    sysbus LoadELF $elf
+    cpu0 VectorTableOffset `sysbus GetSymbolAddress "_vector_table"`
+"""
+runMacro $reset
-- 
2.47.3

