From d05f1919de08e47ff3e1540cb6206c21e986ea3b Mon Sep 17 00:00:00 2001
From: Eryk Szpotanski <eszpotanski@antmicro.com>
Date: Wed, 5 Nov 2025 14:26:48 +0100
Subject: [PATCH 21/37] instrumentation: Add config to use the same timer as
 CTF events

Signed-off-by: Eryk Szpotanski <eszpotanski@antmicro.com>
---
 subsys/instrumentation/CMakeLists.txt        |  1 +
 subsys/instrumentation/Kconfig               | 10 ++++++++++
 subsys/instrumentation/timestamp/timestamp.c |  9 +++++++++
 3 files changed, 20 insertions(+)

diff --git a/subsys/instrumentation/CMakeLists.txt b/subsys/instrumentation/CMakeLists.txt
index 2f88aec09ae..f050551e8f9 100644
--- a/subsys/instrumentation/CMakeLists.txt
+++ b/subsys/instrumentation/CMakeLists.txt
@@ -22,3 +22,4 @@ endif()
 zephyr_compile_definitions_ifdef(CONFIG_INSTRUMENTATION INSTR_TRIGGER_FUNCTION=${CONFIG_INSTRUMENTATION_TRIGGER_FUNCTION})
 zephyr_compile_definitions_ifdef(CONFIG_INSTRUMENTATION INSTR_STOPPER_FUNCTION=${CONFIG_INSTRUMENTATION_STOPPER_FUNCTION})
 zephyr_include_directories_ifdef(CONFIG_INSTRUMENTATION include)
+zephyr_include_directories_ifdef(CONFIG_INSTRUMENTATION_CTF_TIMER ${ZEPHYR_BASE}/kernel/include)
diff --git a/subsys/instrumentation/Kconfig b/subsys/instrumentation/Kconfig
index e9253967901..70ad3544275 100644
--- a/subsys/instrumentation/Kconfig
+++ b/subsys/instrumentation/Kconfig
@@ -127,4 +127,14 @@ config INSTRUMENTATION_EXCLUDE_FILE_LIST
 	  the file name, it is considered to be a match. The files in the list
 	  are separate by a comma, for instance: file0, file1, ...
 
+config INSTRUMENTATION_CTF_TIMER
+	bool "Use the same time measuring mechanism as in CTF events"
+	help
+	  Use timer based on kernel cycles to measure time - the same as for CTF events.
+	  Otherwise, the time measurement API will be used.
+
+choice TRACING_FORMAT_CHOICE
+	default TRACING_CTF if INSTRUMENTATION_CTF_TIMER
+endchoice
+
 endif
diff --git a/subsys/instrumentation/timestamp/timestamp.c b/subsys/instrumentation/timestamp/timestamp.c
index 0ac5a81af6a..fe122b75d2a 100644
--- a/subsys/instrumentation/timestamp/timestamp.c
+++ b/subsys/instrumentation/timestamp/timestamp.c
@@ -5,13 +5,18 @@
  */
 
 #include <zephyr/instrumentation/instrumentation.h>
+#ifdef CONFIG_INSTRUMENTATION_CTF_TIMER
+#include <ctf_top.h>
+#endif
 #include <instr_timestamp.h>
 
 __no_instrumentation__
 int instr_timestamp_init(void)
 {
+#ifndef CONFIG_INSTRUMENTATION_CTF_TIMER
 	timing_init();
 	timing_start();
+#endif /* CONFIG_INSTRUMENTATION_CTF_TIMER */
 
 	return 0;
 }
@@ -19,6 +24,7 @@ int instr_timestamp_init(void)
 __no_instrumentation__
 uint64_t instr_timestamp_ns(void)
 {
+#ifndef CONFIG_INSTRUMENTATION_CTF_TIMER
 	timing_t bigbang = 0;
 	timing_t now;
 	uint64_t now_cycles;
@@ -27,4 +33,7 @@ uint64_t instr_timestamp_ns(void)
 	now_cycles = timing_cycles_get(&bigbang, &now);
 
 	return timing_cycles_to_ns(now_cycles);
+#else
+	return ctf_timestamp_get();
+#endif /* CONFIG_INSTRUMENTATION_CTF_TIMER */
 }
-- 
2.47.3

