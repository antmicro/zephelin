Subject: [PATCH 13/38] subsys: tracing: ctf: add CPU ID to CTF events

Signed-off-by: Maciej Torhan <mtorhan@antmicro.com>
---
 subsys/tracing/ctf/ctf_top.h     |   5 +-
 subsys/tracing/ctf/tsdl/metadata | 273 +++++++++++++++++++++++++++++--
 2 files changed, 266 insertions(+), 12 deletions(-)

diff --git a/subsys/tracing/ctf/ctf_top.h b/subsys/tracing/ctf/ctf_top.h
index 74f4e3755e8..c07a0287394 100644
--- a/subsys/tracing/ctf/ctf_top.h
+++ b/subsys/tracing/ctf/ctf_top.h
@@ -66,7 +66,7 @@ static inline uint64_t ctf_top_timestamp_get(void)
 	return timing_cycles_to_ns(now_cycles);
 }
 
-#define CTF_EVENT(...)                                                                             \
+#define CTF_EVENT(event_id, ...)                                                                   \
 	{                                                                                          \
 		if (!is_tracing_enabled()) {                                                       \
 			return;                                                                    \
@@ -75,7 +75,8 @@ static inline uint64_t ctf_top_timestamp_get(void)
 		const uint16_t stream_id = 0;                                                      \
 		const uint16_t packet_size = 0;                                                    \
 		const uint64_t tstamp = ctf_top_timestamp_get();                                   \
-		CTF_GATHER_FIELDS(stream_id, packet_size, tstamp, __VA_ARGS__)                     \
+		const uint8_t cpu_id = arch_curr_cpu()->id;                                        \
+		CTF_GATHER_FIELDS(stream_id, packet_size, tstamp, event_id, cpu_id, ##__VA_ARGS__) \
 		irq_unlock(key);                                                                   \
 	}
 #else
