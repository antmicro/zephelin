From c1fa7f3531f430016e67f11059b8f1126731f41a Mon Sep 17 00:00:00 2001
From: Andrii Chmutov <achmutov@antmicro.com>
Date: Wed, 17 Dec 2025 12:50:17 +0100
Subject: [PATCH 18/31] scripts: instrumentation: zaru: use objdump from sdk
 for elf32-little

---
 scripts/instrumentation/zaru.py | 57 +++++++++++++++++++++++++++++++--
 1 file changed, 54 insertions(+), 3 deletions(-)

diff --git a/scripts/instrumentation/zaru.py b/scripts/instrumentation/zaru.py
index 2d38c1fcc75..7cb74deed13 100755
--- a/scripts/instrumentation/zaru.py
+++ b/scripts/instrumentation/zaru.py
@@ -27,6 +27,8 @@ import re
 import shutil
 import subprocess
 import tempfile
+from pathlib import Path
+from typing import Optional
 
 import serial
 from colorama import Fore, Style
@@ -47,8 +49,18 @@ ELF = "zephyr/zephyr.elf"
 
 CTF_METADATA = "ctf_metadata"
 
+# Standard directories for Zephyr SDK
+POSSIBLE_ZEPHYR_SDK_LOCATIONS = [
+    "~",
+    "~/.local",
+    "~/.local/opt",
+    "~/bin",
+    "/opt",
+    "/usr/local",
+]
 
-OBJDUMP_CMD = ["objdump", "-t"]
+OBJDUMP_CMD = None
+OBJDUMP_ARGS = ["--target=elf32-little", "-t"]
 
 
 CPPFILT_CMD = ["c++filt"]
@@ -63,6 +75,38 @@ NUM_PING_ATTEMPTS = 20
 TRACE_EVENT_FILENAME = "./trace_event.json"
 
 
+def get_zephyr_sdk() -> Optional[Path]:
+    """
+    Finds the location of Zephyr SDK.
+    """
+    full_sdk_path = os.environ.get("ZEPHYR_SDK_INSTALL_DIR", None)
+    if full_sdk_path is not None:
+        return Path(full_sdk_path)
+    zephyr_sdk = "zephyr-sdk*"
+    for possible_location in POSSIBLE_ZEPHYR_SDK_LOCATIONS:
+        path = next(
+            Path(possible_location).expanduser().glob(zephyr_sdk), None
+        )
+        if path is not None:
+            full_sdk_path = path
+            break
+    return full_sdk_path
+
+
+def get_objdump_from_sdk():
+    """
+    Finds an objdump command in Zephyr SDK.
+    """
+
+    zephyr_sdk = get_zephyr_sdk()
+    if zephyr_sdk is None:
+        return None
+
+    for objdump in zephyr_sdk.glob("*zephyr-*/bin/*zephyr-*-objdump"):
+        return objdump
+    return None
+
+
 def get_symbols_from_elf(elf_file, verbose=False):
     """Get symbols from ELF.
 
@@ -72,7 +116,14 @@ def get_symbols_from_elf(elf_file, verbose=False):
 
     assert elf_file.exists(), f"File '{elf_file}' does not exist!"
 
-    cmd = OBJDUMP_CMD + [elf_file]
+    objdump_cmd = OBJDUMP_CMD
+    if objdump_cmd is None:
+        objdump_cmd = get_objdump_from_sdk()
+    if objdump_cmd is None:
+        # Fallback to system objdump
+        objdump_cmd = "objdump"
+
+    cmd = [str(objdump_cmd)] + OBJDUMP_ARGS + [str(elf_file)]
 
     try:
         output = subprocess.check_output(cmd, text=True)
@@ -81,7 +132,7 @@ def get_symbols_from_elf(elf_file, verbose=False):
         print(f"'{cmd}' failed execution. Check if it is properly installed.")
         sys.exit(2)
     except FileNotFoundError:
-        print(f"Could not find executable '{OBJDUMP_CMD[0]}'. Please install it.")
+        print(f"Could not find executable '{objdump_cmd}'. Please install it.")
         sys.exit(3)
 
     if verbose:
