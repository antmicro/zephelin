From 5e95ee878b5ca0f47046c6550a392569f5bfb7b8 Mon Sep 17 00:00:00 2001
From: Eryk Szpotanski <eszpotanski@antmicro.com>
Date: Fri, 31 Oct 2025 14:12:54 +0100
Subject: [PATCH 5/6] disable instrumentation of custom methods based on config

Signed-off-by: Eryk Szpotanski <eszpotanski@antmicro.com>
---
 tensorflow/lite/micro/micro_interpreter.cc |  4 +++-
 tensorflow/lite/micro/micro_interpreter.h  |  3 +++
 tensorflow/lite/micro/micro_profiler.h     | 10 ++++++++++
 3 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/tensorflow/lite/micro/micro_interpreter.cc b/tensorflow/lite/micro/micro_interpreter.cc
index 7971ff5e..b7eeabb8 100644
--- a/tensorflow/lite/micro/micro_interpreter.cc
+++ b/tensorflow/lite/micro/micro_interpreter.cc
@@ -297,8 +297,10 @@ TfLiteStatus MicroInterpreter::AllocateTensors() {
 }
 
 TfLiteStatus MicroInterpreter::Invoke() {
-#ifdef CONFIG_ZPL_INFERENCE_PROFILING
+#ifdef CONFIG_ZPL_TFLM_PROFILER
   LOG_INF("Starting inference for model %p", model_);
+#endif
+#ifdef CONFIG_ZPL_INFERENCE_PROFILING
   ScopedMicroInterpreterInvoke inference(model_);
 #endif /* CONFIG_ZPL_INFERENCE_PROFILING */
   if (initialization_status_ != kTfLiteOk) {
diff --git a/tensorflow/lite/micro/micro_interpreter.h b/tensorflow/lite/micro/micro_interpreter.h
index 1a3ca0c4..51f0196d 100644
--- a/tensorflow/lite/micro/micro_interpreter.h
+++ b/tensorflow/lite/micro/micro_interpreter.h
@@ -39,6 +39,7 @@ limitations under the License.
 
 #ifdef CONFIG_ZPL_INFERENCE_PROFILING
 extern "C" {
+#include <zpl.h>
 #include <zpl/inference_event.h>
 }
 #endif /* CONFIG_ZPL_INFERENCE_PROFILING */
@@ -220,10 +221,12 @@ class MicroInterpreter {
 struct ScopedMicroInterpreterInvoke {
   const Model *model_;
 
+  __no_zpl_instrumentation__
   explicit ScopedMicroInterpreterInvoke(const Model* model) {
     model_ = model;
     zpl_inference_enter((uint32_t) model_);
   }
+  __no_zpl_instrumentation__
   void EndInference() {
     zpl_inference_exit((uint32_t) model_);
   }
diff --git a/tensorflow/lite/micro/micro_profiler.h b/tensorflow/lite/micro/micro_profiler.h
index 4edb2033..439be24a 100644
--- a/tensorflow/lite/micro/micro_profiler.h
+++ b/tensorflow/lite/micro/micro_profiler.h
@@ -19,6 +19,10 @@ limitations under the License.
 #include "tensorflow/lite/micro/compatibility.h"
 #include "tensorflow/lite/micro/micro_profiler_interface.h"
 
+#ifdef CONFIG_ZPL_TFLM_PROFILER
+#include <zpl.h>
+#endif
+
 namespace tflite {
 
 // MicroProfiler creates a common way to gain fine-grained insight into runtime
@@ -117,6 +121,9 @@ class ScopedMicroProfiler {
 // }
 class ScopedMicroProfiler {
  public:
+#ifdef CONFIG_ZPL_TFLM_PROFILER
+  __no_zpl_instrumentation__
+#endif
   explicit ScopedMicroProfiler(uint16_t subgraph_idx,
                                uint16_t op_idx,
                                const char* tag,
@@ -127,6 +134,9 @@ class ScopedMicroProfiler {
     }
   }
 
+#ifdef CONFIG_ZPL_TFLM_PROFILER
+  __no_zpl_instrumentation__
+#endif
   ~ScopedMicroProfiler() {
     if (profiler_ != nullptr) {
       profiler_->EndEvent(event_handle_);
-- 
2.55.0

