From bad4fcba846bf6be672f2670a01f9bfc5f568fbe Mon Sep 17 00:00:00 2001
From: Grzegorz Latosinski <glatosinski@antmicro.com>
Date: Thu, 27 Aug 2026 16:56:58 +0200
Subject: [PATCH 41/41] scripts: ci: check_compliance.py: Added skipping
 symlinked directories

Signed-off-by: Grzegorz Latosinski <glatosinski@antmicro.com>
---
 scripts/ci/check_compliance.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/scripts/ci/check_compliance.py b/scripts/ci/check_compliance.py
index 9ee8c126f57..1037b9214c1 100755
--- a/scripts/ci/check_compliance.py
+++ b/scripts/ci/check_compliance.py
@@ -105,7 +105,8 @@ def get_files(filter=None, paths=None):
     out = git('diff', '--name-only', *filter_arg, COMMIT_RANGE, *paths_arg)
     files = out.splitlines()
     for file in list(files):
-        if not (GIT_TOP / file).exists():
+        path = GIT_TOP / file
+        if not path.exists() or path.is_dir():
             # Drop submodule directories from the list.
             files.remove(file)
     return files
