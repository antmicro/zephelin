From 18440fa0f481e5325ba58c17269f5f131c2a799c Mon Sep 17 00:00:00 2001
From: Chaitanya Tata <chaitanya@dotstarsystems.com>
Date: Thu, 1 Oct 2026 22:36:00 +0530
Subject: [PATCH 38/41] instrumentation: don't run hooks before the kernel sets
 up TLS

The instrumentation state (_instr_enabled, _instr_on, the recursive
exclude state) is Z_THREAD_LOCAL, but the hooks run from the first
instrumented call, which can be in early boot (arch_data_copy(), or an
inlined helper in the Armv8-M MPU setup), before the kernel has set up
TLS. The TLS pointer is still 0, so every access goes to the variable's
TLS offset taken as an absolute address:

- writes fault where low memory is not writable. On nRF54L (RRAM)
  instr_init() -> instr_enable() usage-faults before anything prints.
- reads return whatever is in the vector table at that offset, so the
  hooks may consider instrumentation enabled and record or recurse on
  the boot stack, depending on the TLS layout.

Also, _instr_on started out true, so the trigger check in
__cyg_profile_func_enter() never called instr_turn_on(): recording did
not start at the trigger, and with a trigger deeper than main() the
buffer filled with unrelated events first.

Make the hooks return until z_sys_post_kernel is set, start with
_instr_on false, and leave both flags to instr_turn_on() in the thread
that calls the trigger, as documented. instr_init() no longer touches
thread-local state.

Signed-off-by: Chaitanya Tata <chaitanya@dotstarsystems.com>
Assisted-by: Claude:claude-opus-5.5
---
 subsys/instrumentation/common/instr_common.c  |  6 +++--
 .../handlers/instr_handlers_gcc.c             | 25 +++++++++++++++++++
 2 files changed, 29 insertions(+), 2 deletions(-)

diff --git a/subsys/instrumentation/common/instr_common.c b/subsys/instrumentation/common/instr_common.c
index 2117ceafa..7027f16e8 100644
--- a/subsys/instrumentation/common/instr_common.c
+++ b/subsys/instrumentation/common/instr_common.c
@@ -126,7 +126,7 @@ const struct device *instrumentation_triggers =
 
 static bool _instr_initialized;
 static Z_THREAD_LOCAL bool _instr_enabled;
-static Z_THREAD_LOCAL bool _instr_on = true;
+static Z_THREAD_LOCAL bool _instr_on;
 static Z_THREAD_LOCAL bool _instr_tracing_disabled;
 static Z_THREAD_LOCAL bool _instr_profiling_disabled;
 static bool _instr_tracing_supported = IS_ENABLED(CONFIG_INSTRUMENTATION_MODE_CALLGRAPH);
@@ -268,8 +268,10 @@ __no_instrumentation__ int instr_init(void)
 	 * instr_enable() at runtime, hence avoiding infinite loop and having to exclude a function
 	 * at compile time. In other words, it allows a better granularity for enabling/disabling
 	 * the instrumentation.
+	 *
+	 * Both flags are thread-local and are set by instr_turn_on() in the
+	 * thread that calls the trigger.
 	 */
-	instr_enable();
 
 	return 0;
 }
diff --git a/subsys/instrumentation/handlers/instr_handlers_gcc.c b/subsys/instrumentation/handlers/instr_handlers_gcc.c
index f57801f31..4f841e483 100644
--- a/subsys/instrumentation/handlers/instr_handlers_gcc.c
+++ b/subsys/instrumentation/handlers/instr_handlers_gcc.c
@@ -8,6 +8,11 @@
 
 #include <zephyr/instrumentation/instrumentation.h>
 
+/* In kernel/init.c. Read directly: k_is_pre_kernel() is an inline from an
+ * instrumented header, so calling it from a hook would recurse.
+ */
+extern bool z_sys_post_kernel;
+
 __no_instrumentation__
 void __cyg_profile_func_enter(void *callee, void *caller)
 {
@@ -21,6 +26,16 @@ void __cyg_profile_func_enter(void *callee, void *caller)
 		return;
 	}
 
+	/*
+	 * The instrumentation state is thread-local. Before the kernel is up
+	 * there is no TLS: reads return whatever is at the variables' TLS
+	 * offsets taken as absolute addresses, and writes can fault. Do
+	 * nothing until then.
+	 */
+	if (!z_sys_post_kernel) {
+		return;
+	}
+
 	/* It's now possible to initialize and enable the instrumentation */
 	if (!instr_initialized()) {
 		instr_init();
@@ -49,6 +64,16 @@ void __cyg_profile_func_exit(void *callee, void *caller)
 		return;
 	}
 
+	/*
+	 * The instrumentation state is thread-local. Before the kernel is up
+	 * there is no TLS: reads return whatever is at the variables' TLS
+	 * offsets taken as absolute addresses, and writes can fault. Do
+	 * nothing until then.
+	 */
+	if (!z_sys_post_kernel) {
+		return;
+	}
+
 	if (!instr_enabled()) {
 		return;
 	}
